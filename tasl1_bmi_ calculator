        style.configure("TLabelframe.Label", background=COLOR_CARD_BG, foreground=COLOR_PRIMARY_DARK,
                         font=("Segoe UI", 11, "bold"))

        style.configure("TLabel", background=COLOR_CARD_BG, foreground=COLOR_TEXT, font=("Segoe UI", 10))
        style.configure("Header.TLabel", background=COLOR_PRIMARY, foreground="white",
