    def _build_history_section(self, parent):
        """Build the scrollable history table and its action buttons."""
        frame = ttk.Labelframe(parent, text="History", padding=12)
        frame.grid(row=1, column=0, columnspan=2, sticky="nsew", pady=(0, 4))
        frame.columnconfigure(0, weight=1)
        frame.rowconfigure(0, weight=1)

        columns = ("date", "name", "weight", "height", "bmi", "category")
        self.history_tree = ttk.Treeview(frame, columns=columns, show="headings", height=10)
        headings = {
            "date": "Date", "name": "Name", "weight": "Weight (kg)",
            "height": "Height (m)", "bmi": "BMI", "category": "Category",
        }
        widths = {"date": 150, "name": 120, "weight": 100, "height": 100, "bmi": 80, "category": 110}
        for col in columns:
            self.history_tree.heading(col, text=headings[col])
            self.history_tree.column(col, width=widths[col], anchor="center")

        vsb = ttk.Scrollbar(frame, orient="vertical", command=self.history_tree.yview)
        self.history_tree.configure(yscrollcommand=vsb.set)

        self.history_tree.grid(row=0, column=0, sticky="nsew")
        vsb.grid(row=0, column=1, sticky="ns")

        btn_row = ttk.Frame(frame, style="Card.TFrame")
        btn_row.grid(row=1, column=0, columnspan=2, sticky="ew", pady=(10, 0))

        ttk.Button(btn_row, text="View Graph", style="Primary.TButton",
                   command=self.view_graph).pack(side="left", padx=(0, 8))
        ttk.Button(btn_row, text="Clear History", style="Danger.TButton",
                   command=self.clear_history).pack(side="left")

    def _build_status_bar(self):
        """Build the status bar shown at the bottom of the window."""
        self.status_var = tk.StringVar(value="Ready. Enter your details and press Calculate BMI (or Enter).")
        status_bar = ttk.Label(self.root, textvariable=self.status_var, style="Status.TLabel",
                                anchor="w", padding=(10, 4))
        status_bar.pack(fill="x", side="bottom")

    # ----------------------------------------------------------------- #
    #  Visual BMI Gauge
    # ----------------------------------------------------------------- #

    def _draw_bmi_scale(self, current_bmi=None):
        """
        Draw the horizontal color-banded BMI scale on the canvas, with an
        optional marker indicating where the current BMI value falls.
        """
        canvas = self.scale_canvas
        canvas.delete("all")
        width = canvas.winfo_width()
        height = canvas.winfo_height()
        if width < 10 or height < 10:
            return

        bar_top = height * 0.35
        bar_bottom = height * 0.75
        span = BMI_SCALE_MAX - BMI_SCALE_MIN

        def x_for(value):
            value = max(BMI_SCALE_MIN, min(BMI_SCALE_MAX, value))
            return ((value - BMI_SCALE_MIN) / span) * width

        # Draw colored bands
        for label, low, high, color in BMI_BANDS:
            x0, x1 = x_for(low), x_for(high)
            canvas.create_rectangle(x0, bar_top, x1, bar_bottom, fill=color, outline="")

        # Draw marker for current BMI
        if current_bmi is not None:
            marker_x = x_for(current_bmi)
            canvas.create_polygon(
                marker_x - 7, bar_top - 12, marker_x + 7, bar_top - 12, marker_x, bar_top - 1,
                fill=COLOR_PRIMARY_DARK, outline=""
            )
            canvas.create_line(marker_x, bar_top, marker_x, bar_bottom, fill="white", width=2)
            canvas.create_text(marker_x, bar_bottom + 12, text=str(current_bmi),
                                fill=COLOR_TEXT, font=("Segoe UI", 9, "bold"))

    # ----------------------------------------------------------------- #
    #  Core Logic: Calculate / Validate / Save
    # ----------------------------------------------------------------- #

    def calculate_bmi(self):
        """
        Validate inputs, compute the BMI, update the results display,
        persist the record to the database, and refresh the history table.
        """
        name = self.name_var.get().strip()
        weight_text = self.weight_var.get().strip()
        height_text = self.height_var.get().strip()

        # --- Validation: empty fields ---
        if not name:
            messagebox.showerror("Missing Name", "Please enter your name before calculating.")
            return
        if not weight_text or not height_text:
            messagebox.showerror("Missing Input", "Please enter both weight and height.")
            return

        # --- Validation: numeric values ---
        try:
            weight = float(weight_text)
        except ValueError:
            messagebox.showerror("Invalid Weight", "Weight must be a numeric value (e.g. 70.5).")
            return
        try:
            height = float(height_text)
        except ValueError:
            messagebox.showerror("Invalid Height", "Height must be a numeric value (e.g. 1.75).")
            return

        # --- Validation: positive values ---
        if weight <= 0:
            messagebox.showerror("Invalid Weight", "Weight must be greater than 0.")
            return
        if height <= 0:
            messagebox.showerror("Invalid Height", "Height must be greater than 0.")
            return

        # --- Compute BMI ---
        bmi = compute_bmi(weight, height)
        category = classify_bmi(bmi)

        # --- Update results display ---
        self.bmi_value_label.config(text=f"{bmi:.2f}", foreground=CATEGORY_COLORS[category])
        self.bmi_category_label.config(text=category, foreground=CATEGORY_COLORS[category])
        self._draw_bmi_scale(current_bmi=bmi)

        # --- Persist to database ---
        try:
            timestamp = self.db.insert_record(name, weight, height, bmi, category)
        except sqlite3.Error as db_error:
            messagebox.showerror("Database Error", f"Could not save record:\n{db_error}")
            return

        self._load_history()
        self.status_var.set(f"Last calculated for '{name}' at {timestamp}  |  BMI: {bmi:.2f} ({category})")
        messagebox.showinfo("Success", f"BMI calculated and saved successfully!\n\nBMI: {bmi:.2f}\nCategory: {category}")

    def clear_all(self):
        """Reset all input fields and the results display (does not affect saved history)."""
        self.name_var.set("")
        self.weight_var.set("")
        self.height_var.set("")
        self.bmi_value_label.config(text="--", foreground=COLOR_MUTED)
        self.bmi_category_label.config(text="Enter details and calculate", foreground=COLOR_MUTED)
        self._draw_bmi_scale()
        self.status_var.set("Inputs cleared. Ready for a new calculation.")

    # ----------------------------------------------------------------- #
    #  History Table
    # ----------------------------------------------------------------- #

    def _load_history(self):
        """Refresh the history Treeview with all records from the database."""
        for row in self.history_tree.get_children():
            self.history_tree.delete(row)

        for timestamp, name, weight, height, bmi, category in self.db.fetch_all_records():
            self.history_tree.insert(
                "", "end",
                values=(timestamp, name, f"{weight:.1f}", f"{height:.2f}", f"{bmi:.2f}", category),
                tags=(category,)
            )
            self.history_tree.tag_configure(category, foreground=CATEGORY_COLORS.get(category, COLOR_TEXT))

    def clear_history(self):
        """Ask for confirmation, then delete all saved records from the database."""
        if not self.db.fetch_all_records():
            messagebox.showinfo("History Empty", "There is no history to clear.")
            return

        confirmed = messagebox.askyesno(
            "Confirm Clear History",
            "This will permanently delete ALL saved BMI records.\nAre you sure you want to continue?"
        )
        if confirmed:
            self.db.clear_all_records()
            self._load_history()
            self.status_var.set("History cleared.")

    # ----------------------------------------------------------------- #
    #  Graph Window
    # ----------------------------------------------------------------- #

    def view_graph(self):
        """Open a new window showing a line chart of BMI trend over time."""
        records = self.db.fetch_records_chronological()
        if not records:
            messagebox.showinfo("No Data", "No records available yet. Calculate a BMI first.")
            return

        dates = [r[0].split(" ")[0] + "\n" + r[0].split(" ")[1] for r in records]
        bmi_values = [r[4] for r in records]
        categories = [r[5] for r in records]

        graph_window = tk.Toplevel(self.root)
        graph_window.title("BMI Trend Over Time - Oasis Infobyte")
        graph_window.geometry("880x560")
        graph_window.configure(bg=COLOR_BG)

        figure = Figure(figsize=(8.5, 5), dpi=100)
        ax = figure.add_subplot(111)

        # Line connecting all points chronologically
        ax.plot(range(len(bmi_values)), bmi_values, color=COLOR_PRIMARY, linewidth=1.8, zorder=1)

        # Scatter points colored by category
        point_colors = [CATEGORY_COLORS.get(cat, COLOR_TEXT) for cat in categories]
        ax.scatter(range(len(bmi_values)), bmi_values, c=point_colors, s=55, zorder=2, edgecolors="white")

        ax.set_title("BMI Trend Over Time", fontsize=14, fontweight="bold", color=COLOR_PRIMARY_DARK)
        ax.set_xlabel("Date", fontsize=10)
        ax.set_ylabel("BMI Value", fontsize=10)
        ax.set_xticks(range(len(dates)))
        ax.set_xticklabels(dates, rotation=45, ha="right", fontsize=7)
        ax.grid(True, linestyle="--", alpha=0.5)

        # Reference lines for BMI category boundaries
        for _, low, _, _ in BMI_BANDS[1:]:
            ax.axhline(y=low, color="gray", linestyle=":", linewidth=0.8, alpha=0.6)

        # Legend for category colors
        handles = [
            plt.Line2D([0], [0], marker="o", color="w", markerfacecolor=color, markersize=8, label=label)
            for label, _, _, color in BMI_BANDS
        ]
        ax.legend(handles=handles, loc="upper left", fontsize=8, framealpha=0.9)

        figure.tight_layout()

        canvas = FigureCanvasTkAgg(figure, master=graph_window)
        canvas.draw()
        canvas.get_tk_widget().pack(fill="both", expand=True, padx=10, pady=10)

    # ----------------------------------------------------------------- #
    #  Shutdown
    # ----------------------------------------------------------------- #

    def _on_close(self):
        """Close the database connection and destroy the window cleanly."""
        self.db.close()
        self.root.destroy()


# --------------------------------------------------------------------------- #
#  Entry Point
# --------------------------------------------------------------------------- #

def main():
    """Launch the BMI Calculator application."""
    root = tk.Tk()
    app = BMICalculatorApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
