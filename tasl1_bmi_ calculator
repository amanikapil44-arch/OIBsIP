        frame.grid(row=0, column=1, sticky="nsew", padx=(8, 0), pady=(0, 12))
        frame.columnconfigure(0, weight=1)

        self.bmi_value_label = ttk.Label(frame, text="--", style="ResultBMI.TLabel", foreground=COLOR_MUTED)
        self.bmi_value_label.grid(row=0, column=0, pady=(4, 0))

