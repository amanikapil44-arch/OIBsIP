import os
import sqlite3
import tkinter as tk
from datetime import datetime
from tkinter import ttk, messagebox

import matplotlib
matplotlib.use("TkAgg")  # Ensure matplotlib renders inside Tkinter windows
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
from matplotlib.figure import Figure


# --------------------------------------------------------------------------- #
#  Configuration / Constants
# --------------------------------------------------------------------------- #

DB_FILENAME = "bmi_records.db"  # Created automatically alongside this script
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), DB_FILENAME)

# Color palette (professional blue & white theme)
COLOR_PRIMARY = "#1565C0"       # Deep blue - headers / buttons
COLOR_PRIMARY_DARK = "#0D47A1"  # Darker blue - hover / accents
COLOR_BG = "#F4F8FC"            # Very light blue-white - window background
COLOR_CARD_BG = "#FFFFFF"       # White - card/section backgrounds
COLOR_TEXT = "#1A1A1A"          # Near-black text
COLOR_MUTED = "#5C6B7A"         # Muted gray-blue text

# BMI category colors
CATEGORY_COLORS = {
    "Underweight": "#FFA000",   # Amber / Orange-Yellow
    "Normal": "#2E7D32",        # Green
    "Overweight": "#EF6C00",    # Orange
    "Obese": "#C62828",         # Red
}

# BMI scale boundaries used both for classification and the visual gauge
BMI_SCALE_MIN = 10.0
BMI_SCALE_MAX = 40.0
BMI_BANDS = [
    ("Underweight", BMI_SCALE_MIN, 18.5, CATEGORY_COLORS["Underweight"]),
    ("Normal", 18.5, 25.0, CATEGORY_COLORS["Normal"]),
    ("Overweight", 25.0, 30.0, CATEGORY_COLORS["Overweight"]),
    ("Obese", 30.0, BMI_SCALE_MAX, CATEGORY_COLORS["Obese"]),
]


# --------------------------------------------------------------------------- #
#  Database Layer
# --------------------------------------------------------------------------- #

class BMIDatabase:
    """Handles all SQLite database operations for BMI records."""

    def __init__(self, db_path=DB_PATH):
        """Connect to (or create) the SQLite database and ensure the schema exists."""
        self.db_path = db_path
        self.connection = sqlite3.connect(self.db_path)
        self.connection.execute("PRAGMA foreign_keys = ON;")
        self._create_table()

    def _create_table(self):
        """Create the `records` table if it does not already exist."""
        query = """
            CREATE TABLE IF NOT EXISTS records (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT NOT NULL,
                name TEXT NOT NULL,
                weight REAL NOT NULL,
                height REAL NOT NULL,
                bmi REAL NOT NULL,
                category TEXT NOT NULL
            );
        """
        with self.connection:
            self.connection.execute(query)

    def insert_record(self, name, weight, height, bmi, category):
        """Insert a new BMI record with the current timestamp."""
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        query = """
            INSERT INTO records (timestamp, name, weight, height, bmi, category)
            VALUES (?, ?, ?, ?, ?, ?);
        """
        with self.connection:
            self.connection.execute(query, (timestamp, name, weight, height, bmi, category))
        return timestamp

    def fetch_all_records(self):
        """Return all records ordered by most recent first."""
        query = "SELECT timestamp, name, weight, height, bmi, category FROM records ORDER BY id DESC;"
        cursor = self.connection.execute(query)
        return cursor.fetchall()

    def fetch_records_chronological(self):
        """Return all records ordered oldest-to-newest (for graphing trends)."""
        query = "SELECT timestamp, name, weight, height, bmi, category FROM records ORDER BY id ASC;"
        cursor = self.connection.execute(query)
        return cursor.fetchall()

    def clear_all_records(self):
        """Delete every record from the database."""
        with self.connection:
            self.connection.execute("DELETE FROM records;")

    def close(self):
        """Close the database connection cleanly."""
        self.connection.close()


# --------------------------------------------------------------------------- #
#  BMI Calculation Helpers
# --------------------------------------------------------------------------- #

def compute_bmi(weight_kg, height_m):
    """
    Compute BMI given weight in kilograms and height in meters.

    Formula: BMI = weight (kg) / height (m)^2

    Returns the BMI rounded to 2 decimal places.
    """
    bmi = weight_kg / (height_m ** 2)
    return round(bmi, 2)


def classify_bmi(bmi):
    """Return the BMI category label (Underweight/Normal/Overweight/Obese)."""
    if bmi < 18.5:
        return "Underweight"
    elif bmi < 25.0:
        return "Normal"
    elif bmi < 30.0:
        return "Overweight"
    else:
        return "Obese"


