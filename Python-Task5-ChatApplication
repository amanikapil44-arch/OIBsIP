    # ---- chat window actions ----
    def toggle_dark_mode(self):
        self.dark_mode = not self.dark_mode
        self.show_chat()
        if self.current_room:
            self.render_room_header()

    def logout(self):
        self.net.close()
        self.username = None
        self.current_room = None
        self.joined_rooms = set()
        self.show_login()

    def on_close(self):
        self.net.close()
        self.root.destroy()

    def create_room(self):
        room = self.new_room_entry.get().strip()
        if not room:
            return
        self.net.send({"action": "create_room", "room": room})
        self.new_room_entry.delete(0, tk.END)

    def on_room_double_click(self, event):
        selection = self.room_listbox.curselection()
        if not selection:
            return
        text = self.room_listbox.get(selection[0])
        room_name = text.split("  (")[0].replace("\u25CF ", "").strip()
        self.join_room(room_name)

    def join_room(self, room_name):
        if self.current_room == room_name:
            return
        self.current_room = room_name
        self.joined_rooms.add(room_name)
        self.net.send({"action": "join_room", "room": room_name})
        self.render_room_header()

    def leave_current_room(self):
        if not self.current_room:
            return
        self.net.send({"action": "leave_room", "room": self.current_room})
        self.joined_rooms.discard(self.current_room)
        self.current_room = None
        self.clear_chat_display()
        self.room_title_label.config(text="Select a room to begin chatting")
        self.user_listbox.delete(0, tk.END)

    def render_room_header(self):
        self.room_title_label.config(text=f"# {self.current_room}")

    def clear_chat_display(self):
        self.chat_display.config(state="normal")
        self.chat_display.delete("1.0", tk.END)
        self.chat_display.config(state="disabled")

    def append_message(self, username, message, timestamp, system=False, private=False):
        self.chat_display.config(state="normal")
        at_bottom = self.chat_display.yview()[1] >= 0.98

        self.chat_display.insert(tk.END, f"[{timestamp}] ", "timestamp")
        if system:
            self.chat_display.insert(tk.END, f"{message}\n", "system")
        elif private:
            self.chat_display.insert(tk.END, f"(private) {username}: {message}\n", "private")
        else:
            tag = f"user_{username}"
            if tag not in self.chat_display.tag_names():
                self.chat_display.tag_configure(tag, foreground=color_for_username(username),
                                                 font=(FONT_FAMILY, FONT_SIZE, "bold"))
            self.chat_display.insert(tk.END, f"{username}: ", tag)
            self.chat_display.insert(tk.END, f"{message}\n")

        self.chat_display.config(state="disabled")
        if at_bottom:
            self.chat_display.see(tk.END)

    def send_message(self):
        text = self.message_entry.get().strip()
        if not text or not self.current_room:
            return
        text = replace_emoji_shortcodes(text)
        self.net.send({"action": "send_message", "room": self.current_room, "message": text})
        self.message_entry.delete(0, tk.END)

    def insert_emoji(self, shortcode):
        self.message_entry.insert(tk.INSERT, EMOJI_MAP[shortcode])
        self.message_entry.focus_set()

    def on_typing(self, event):
        if not self.current_room:
            return
        now = datetime.now().timestamp()
        if now - self._last_typing_sent > 1.5:
            self._last_typing_sent = now
            self.net.send({"action": "typing", "room": self.current_room})

    def show_typing_indicator(self, username):
        self.typing_label.config(text=f"{username} is typing...")
        if self._typing_after_id:
            self.root.after_cancel(self._typing_after_id)
        self._typing_after_id = self.root.after(2500, lambda: self.typing_label.config(text=""))

    def open_private_message_dialog(self):
        target = simpledialog.askstring("Private Message", "Send private message to (username):",
                                         parent=self.root)
        if not target:
            return
        text = simpledialog.askstring("Private Message", f"Message to {target}:", parent=self.root)
        if not text:
            return
        text = replace_emoji_shortcodes(text)
        self.net.send({"action": "private_message", "to": target, "message": text})

    def search_messages(self):
        query = self.search_entry.get().strip()
        self.chat_display.tag_remove("search_hit", "1.0", tk.END)
        if not query:
            return
        start = "1.0"
        count = 0
        while True:
            pos = self.chat_display.search(query, start, stopindex=tk.END, nocase=True)
            if not pos:
                break
            end = f"{pos}+{len(query)}c"
            self.chat_display.tag_add("search_hit", pos, end)
            start = end
            count += 1
        if count:
            first = self.chat_display.tag_ranges("search_hit")[0]
            self.chat_display.see(first)
        else:
            messagebox.showinfo("Search", "No matches found.")

    def show_context_menu(self, event):
        try:
            self.context_menu.tk_popup(event.x_root, event.y_root)
        finally:
            self.context_menu.grab_release()

    def copy_selection(self):
        try:
            selected = self.chat_display.get(tk.SEL_FIRST, tk.SEL_LAST)
            self.root.clipboard_clear()
            self.root.clipboard_append(selected)
        except tk.TclError:
            pass

    # ---- incoming message dispatch ----
    def process_queue(self):
        try:
            while True:
                obj = self.incoming.get_nowait()
                self.handle_server_message(obj)
        except queue.Empty:
            pass
        self.root.after(100, self.process_queue)

    def handle_server_message(self, obj):
        msg_type = obj.get("type")

        if msg_type == "login_result":
            self.on_login_result(obj)
        elif msg_type == "register_result":
            self.on_register_result(obj)
        elif msg_type == "room_list":
            self.on_room_list(obj)
        elif msg_type == "room_joined":
            self.on_room_joined(obj)
        elif msg_type == "message":
            self.on_message(obj)
        elif msg_type == "user_list":
            self.on_user_list(obj)
        elif msg_type == "private_message":
            self.on_private_message(obj)
        elif msg_type == "typing":
            self.show_typing_indicator(obj.get("username", "Someone"))
        elif msg_type == "error":
            messagebox.showerror("Error", obj.get("message", "Unknown error."))
        elif msg_type == "kicked":
            messagebox.showwarning("Disconnected", obj.get("message", "You were kicked."))
            self.logout()
        elif msg_type == "server_shutdown":
            messagebox.showinfo("Server", obj.get("message", "Server is shutting down."))
            self.logout()
        elif msg_type == "_connection_lost":
            if self.username:
                messagebox.showwarning("Connection Lost", "Lost connection to the server.")
                self.logout()

    def on_login_result(self, obj):
        if obj.get("success"):
            self.username = obj.get("username") or getattr(self, "_pending_login_username", None)
            self.show_chat()
        else:
            if hasattr(self, "_login_status_label"):
                self._login_status_label.config(text=obj.get("message", "Login failed."), fg="#c0392b")

    def on_register_result(self, obj):
        if obj.get("success"):
            messagebox.showinfo("Registration", obj.get("message", "Registered successfully!"))
            self.show_login()
        else:
            if hasattr(self, "_register_status_label"):
                self._register_status_label.config(text=obj.get("message", "Registration failed."))

    def on_room_list(self, obj):
        self.rooms_data = obj.get("rooms", [])
        if not hasattr(self, "room_listbox"):
            return
        self.room_listbox.delete(0, tk.END)
        for r in self.rooms_data:
            marker = "\u25CF " if r["name"] == self.current_room else ""
            self.room_listbox.insert(tk.END, f"{marker}{r['name']}  ({r['users']})")

    def on_room_joined(self, obj):
        room = obj.get("room")
        if room != self.current_room:
            return
        self.clear_chat_display()
        for m in obj.get("history", []):
            self.append_message(m["username"], m["message"], m["timestamp"], system=m.get("system", False))
        self.render_room_header()

    def on_message(self, obj):
        room = obj.get("room")
        if room is None:
            self.append_message("SERVER", obj.get("message", ""), obj.get("timestamp", ""), system=True)
            return
        if room != self.current_room:
            return
        self.append_message(obj.get("username"), obj.get("message"), obj.get("timestamp"),
                             system=obj.get("system", False))

    def on_user_list(self, obj):
        room = obj.get("room")
        if room != self.current_room:
            return
        self.user_listbox.delete(0, tk.END)
        for u in obj.get("users", []):
            status = "\U0001F7E2" if u.get("online") else "\u26AA"
            self.user_listbox.insert(tk.END, f"{status} {u['username']}")

    def on_private_message(self, obj):
        self.append_message(f"{obj['from']} -> {obj['to']}", obj["message"], obj["timestamp"], private=True)

    def run(self):
        self.root.mainloop()


