def now_ts():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def hash_password(password):
    return hashlib.sha256(password.encode("utf-8")).hexdigest()


def log(msg):
    print(f"[{now_ts()}] {msg}")


def replace_emoji_shortcodes(text):
    for code, emoji in EMOJI_MAP.items():
        text = text.replace(code, emoji)
    return text


def color_for_username(username):
    if not username:
        return USER_COLORS[0]
    return USER_COLORS[sum(ord(c) for c in username) % len(USER_COLORS)]


# =============================================================================
# SECTION 1: Database layer (used by the server)
# =============================================================================
class Database:
    """Thin wrapper around the sqlite3 connection. One connection is shared
    across threads; access is serialized with a lock since sqlite3 objects
    are not thread-safe by default."""

    def __init__(self, path):
        self.lock = threading.Lock()
        self.conn = sqlite3.connect(path, check_same_thread=False)
        self.conn.execute("PRAGMA foreign_keys = ON")
        self._create_tables()
        self._seed_default_rooms()

    def _create_tables(self):
        with self.lock:
            cur = self.conn.cursor()
            cur.execute("""
                CREATE TABLE IF NOT EXISTS users (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    username TEXT UNIQUE NOT NULL,
                    password TEXT NOT NULL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)
            cur.execute("""
                CREATE TABLE IF NOT EXISTS rooms (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT UNIQUE NOT NULL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            """)
            cur.execute("""
                CREATE TABLE IF NOT EXISTS messages (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    room TEXT NOT NULL,
                    username TEXT NOT NULL,
                    message TEXT NOT NULL,
                    is_system INTEGER DEFAULT 0,
                    timestamp TEXT NOT NULL
                )
            """)
            self.conn.commit()

    def _seed_default_rooms(self):
        with self.lock:
            cur = self.conn.cursor()
            for room in DEFAULT_ROOMS:
                cur.execute("INSERT OR IGNORE INTO rooms (name) VALUES (?)", (room,))
            self.conn.commit()

    # ---- users ----
    def create_user(self, username, password):
        with self.lock:
            cur = self.conn.cursor()
            cur.execute("SELECT id FROM users WHERE username = ?", (username,))
            if cur.fetchone():
                return False, "Username already exists."
            cur.execute(
                "INSERT INTO users (username, password) VALUES (?, ?)",
                (username, hash_password(password)),
            )
            self.conn.commit()
            return True, "Registration successful."

    def validate_login(self, username, password):
        with self.lock:
            cur = self.conn.cursor()
            cur.execute("SELECT password FROM users WHERE username = ?", (username,))
            row = cur.fetchone()
            if not row:
                return False, "User does not exist."
            if row[0] != hash_password(password):
                return False, "Incorrect password."
            return True, "Login successful."

    # ---- rooms ----
    def create_room(self, room_name):
        with self.lock:
            cur = self.conn.cursor()
            cur.execute("SELECT id FROM rooms WHERE name = ?", (room_name,))
            if cur.fetchone():
                return False
            cur.execute("INSERT INTO rooms (name) VALUES (?)", (room_name,))
            self.conn.commit()
            return True

    def list_rooms(self):
        with self.lock:
            cur = self.conn.cursor()
            cur.execute("SELECT name FROM rooms ORDER BY name")
            return [r[0] for r in cur.fetchall()]

    # ---- messages ----
    def save_message(self, room, username, message, is_system=False):
        ts = now_ts()
        with self.lock:
            cur = self.conn.cursor()
            cur.execute(
                "INSERT INTO messages (room, username, message, is_system, timestamp) "
                "VALUES (?, ?, ?, ?, ?)",
                (room, username, message, int(is_system), ts),
            )
            self.conn.commit()
        return ts

    def get_history(self, room, limit=HISTORY_LIMIT):
        with self.lock:
            cur = self.conn.cursor()
            cur.execute(
                "SELECT username, message, is_system, timestamp FROM messages "
                "WHERE room = ? ORDER BY id DESC LIMIT ?",
                (room, limit),
            )
            rows = cur.fetchall()
        rows.reverse()
        return [
            {"username": u, "message": m, "system": bool(s), "timestamp": t}
            for (u, m, s, t) in rows
        ]


# =============================================================================
# SECTION 2: Chat Server
# =============================================================================
class ChatServer:
    def __init__(self, host, port):
        self.host = host
        self.port = port
        self.db = Database(DB_PATH)

        self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

        self.lock = threading.RLock()
        self.clients = {}   # conn -> {"username": str|None, "rooms": set(), "addr":...}
        self.rooms = {}     # room_name -> set(conn)

        self.running = False

    # ---- networking helpers ----
    @staticmethod
    def send_json(conn, obj):
        try:
            data = (json.dumps(obj) + "\n").encode("utf-8")
            conn.sendall(data)
        except OSError:
            pass

    def broadcast_to_room(self, room, obj, exclude=None):
        with self.lock:
            conns = list(self.rooms.get(room, set()))
        for c in conns:
            if c is exclude:
                continue
            self.send_json(c, obj)

    def broadcast_to_all(self, obj):
        with self.lock:
            conns = list(self.clients.keys())
        for c in conns:
            self.send_json(c, obj)

    # ---- room list / user list helpers ----
    def room_list_payload(self):
        rooms = self.db.list_rooms()
        with self.lock:
            counts = {r: len(self.rooms.get(r, set())) for r in rooms}
        return {
            "type": "room_list",
            "rooms": [{"name": r, "users": counts.get(r, 0)} for r in rooms],
        }

    def send_room_list_to_all(self):
        self.broadcast_to_all(self.room_list_payload())

    def user_list_payload(self, room):
        with self.lock:
            conns = self.rooms.get(room, set())
            usernames = sorted(
                self.clients[c]["username"] for c in conns if self.clients[c]["username"]
            )
        return {"type": "user_list", "room": room,
                "users": [{"username": u, "online": True} for u in usernames]}

    def send_user_list_to_room(self, room):
        self.broadcast_to_room(room, self.user_list_payload(room))

    # ---- lifecycle ----
    def start(self):
        self.server_socket.bind((self.host, self.port))
        self.server_socket.listen(20)
        self.running = True

        log("=" * 60)
        log("  CHAT SERVER STARTED")
        log(f"  Listening on {self.host}:{self.port}")
        log(f"  Database: {DB_PATH}")
        log("=" * 60)
        log("Type 'help' for admin commands.")

        threading.Thread(target=self.admin_console, daemon=True).start()

        try:
            while self.running:
                try:
                    conn, addr = self.server_socket.accept()
                except OSError:
                    break
                with self.lock:
                    self.clients[conn] = {"username": None, "rooms": set(), "addr": addr}
                log(f"New connection from {addr} | Total clients: {len(self.clients)}")
                threading.Thread(target=self.handle_client, args=(conn, addr), daemon=True).start()
        finally:
            self.shutdown()

    def start_in_background(self):
        """Start the accept-loop in a daemon thread (used by the embedded
        "auto-start local server" convenience option in the client)."""
        threading.Thread(target=self.start, daemon=True).start()

    def shutdown(self):
        if not self.running:
            return
        self.running = False
        log("Shutting down server...")
        self.broadcast_to_all({"type": "server_shutdown", "message": "Server is shutting down."})
        with self.lock:
            conns = list(self.clients.keys())
        for c in conns:
            try:
                c.close()
            except OSError:
                pass
        try:
            self.server_socket.close()
        except OSError:
            pass
        log("Server stopped.")

    # ---- client handling ----
    def handle_client(self, conn, addr):
        buffer = ""
        try:
            while True:
                try:
                    chunk = conn.recv(4096)
                except OSError:
                    break
                if not chunk:
                    break
                try:
                    buffer += chunk.decode("utf-8")
                except UnicodeDecodeError:
                    continue
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        obj = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    self.dispatch(conn, obj)
        finally:
            self.disconnect_client(conn, addr)

    def dispatch(self, conn, obj):
        action = obj.get("action")
        with self.lock:
            client_info = self.clients.get(conn)
        if client_info is None:
            return

        if action == "register":
            self.handle_register(conn, obj)
        elif action == "login":
            self.handle_login(conn, obj)
        elif action == "list_rooms":
            self.send_json(conn, self.room_list_payload())
        elif action == "create_room":
            self.handle_create_room(conn, obj)
        elif action == "join_room":
            self.handle_join_room(conn, obj)
        elif action == "leave_room":
            self.handle_leave_room(conn, obj)
        elif action == "send_message":
            self.handle_send_message(conn, obj)
        elif action == "list_users":
            room = obj.get("room")
            if room:
                self.send_json(conn, self.user_list_payload(room))
        elif action == "private_message":
            self.handle_private_message(conn, obj)
        elif action == "typing":
            self.handle_typing(conn, obj)
        else:
            self.send_json(conn, {"type": "error", "message": f"Unknown action '{action}'."})

    # ---- auth ----
    def handle_register(self, conn, obj):
        username = (obj.get("username") or "").strip()
        password = obj.get("password") or ""
        if not username or not password:
            self.send_json(conn, {"type": "register_result", "success": False,
                                   "message": "Username and password required."})
            return
        success, message = self.db.create_user(username, password)
        self.send_json(conn, {"type": "register_result", "success": success, "message": message})
        log(f"Registration attempt for '{username}': {'OK' if success else 'FAILED - ' + message}")

    def handle_login(self, conn, obj):
        username = (obj.get("username") or "").strip()
        password = obj.get("password") or ""
        success, message = self.db.validate_login(username, password)

        if success:
            with self.lock:
                for c, info in self.clients.items():
                    if info["username"] == username and c is not conn:
                        self.send_json(conn, {"type": "login_result", "success": False,
                                               "message": "User already logged in elsewhere."})
                        return
                self.clients[conn]["username"] = username

        self.send_json(conn, {"type": "login_result", "success": success, "message": message,
                               "username": username if success else None})
        if success:
            log(f"User '{username}' logged in from {self.clients[conn]['addr']}.")
            self.send_json(conn, self.room_list_payload())

    # ---- rooms ----
    def handle_create_room(self, conn, obj):
        room = (obj.get("room") or "").strip()
        if not room:
            self.send_json(conn, {"type": "error", "message": "Room name cannot be empty."})
            return
        created = self.db.create_room(room)
        if created:
            log(f"Room created: '{room}'")
            self.send_room_list_to_all()
        else:
            self.send_json(conn, {"type": "error", "message": f"Room '{room}' already exists."})

    def handle_join_room(self, conn, obj):
        room = obj.get("room")
        username = self.clients[conn]["username"]
        if not room or not username:
            return
        if room not in self.db.list_rooms():
            self.send_json(conn, {"type": "error", "message": "Room does not exist."})
            return

        with self.lock:
            self.rooms.setdefault(room, set()).add(conn)
            self.clients[conn]["rooms"].add(room)

        history = self.db.get_history(room)
        self.send_json(conn, {"type": "room_joined", "room": room, "history": history})

        join_msg = f"{username} joined the room."
        ts = self.db.save_message(room, "SYSTEM", join_msg, is_system=True)
        self.broadcast_to_room(room, {"type": "message", "room": room, "username": "SYSTEM",
                                       "message": join_msg, "timestamp": ts, "system": True})
        self.send_user_list_to_room(room)
        self.send_room_list_to_all()
        log(f"'{username}' joined room '{room}'.")

    def handle_leave_room(self, conn, obj):
        room = obj.get("room")
        username = self.clients[conn]["username"]
        if not room or not username:
            return
        with self.lock:
            self.rooms.get(room, set()).discard(conn)
            self.clients[conn]["rooms"].discard(room)

        leave_msg = f"{username} left the room."
        ts = self.db.save_message(room, "SYSTEM", leave_msg, is_system=True)
        self.broadcast_to_room(room, {"type": "message", "room": room, "username": "SYSTEM",
                                       "message": leave_msg, "timestamp": ts, "system": True})
        self.send_user_list_to_room(room)
        self.send_room_list_to_all()
        log(f"'{username}' left room '{room}'.")

    # ---- messaging ----
    def handle_send_message(self, conn, obj):
        room = obj.get("room")
        text = obj.get("message")
        username = self.clients[conn]["username"]
        if not room or not text or not username:
            return
        if room not in self.clients[conn]["rooms"]:
            self.send_json(conn, {"type": "error", "message": "You are not in that room."})
            return
        ts = self.db.save_message(room, username, text, is_system=False)
        self.broadcast_to_room(room, {"type": "message", "room": room, "username": username,
                                       "message": text, "timestamp": ts, "system": False})

    def handle_private_message(self, conn, obj):
        to_user = obj.get("to")
        text = obj.get("message")
        from_user = self.clients[conn]["username"]
        if not to_user or not text or not from_user:
            return
        target_conn = None
        with self.lock:
            for c, info in self.clients.items():
                if info["username"] == to_user:
                    target_conn = c
                    break
        ts = now_ts()
        payload = {"type": "private_message", "from": from_user, "to": to_user,
                   "message": text, "timestamp": ts}
        if target_conn:
            self.send_json(target_conn, payload)
            self.send_json(conn, payload)
        else:
            self.send_json(conn, {"type": "error", "message": f"User '{to_user}' is not online."})

    def handle_typing(self, conn, obj):
        room = obj.get("room")
        username = self.clients[conn]["username"]
        if room and username:
            self.broadcast_to_room(room, {"type": "typing", "room": room, "username": username}, exclude=conn)

    # ---- disconnect ----
    def disconnect_client(self, conn, addr):
        with self.lock:
            info = self.clients.pop(conn, None)
        if info is None:
            return
        username = info["username"]
        rooms = list(info["rooms"])
        for room in rooms:
            with self.lock:
                self.rooms.get(room, set()).discard(conn)
            if username:
                leave_msg = f"{username} disconnected."
                ts = self.db.save_message(room, "SYSTEM", leave_msg, is_system=True)
                self.broadcast_to_room(room, {"type": "message", "room": room, "username": "SYSTEM",
                                               "message": leave_msg, "timestamp": ts, "system": True})
            self.send_user_list_to_room(room)
        try:
            conn.close()
        except OSError:
            pass
        self.send_room_list_to_all()
        log(f"Connection closed: {addr} (user: {username}) | Total clients: {len(self.clients)}")

    # ---- admin console ----
    def admin_console(self):
        while self.running:
            try:
                line = input()
            except (EOFError, OSError):
                break
            if not line.strip():
                continue
            parts = line.strip().split(" ", 1)
            cmd = parts[0].lower()
            arg = parts[1] if len(parts) > 1 else ""

            if cmd == "help":
                print("Available commands:")
                print("  rooms                 - list rooms with online counts")
                print("  users <room>           - list users currently in <room>")
                print("  broadcast <message>    - send a system message to all users")
                print("  kick <username>        - disconnect a user")
                print("  shutdown               - stop the server")
            elif cmd == "rooms":
                for r in self.db.list_rooms():
                    with self.lock:
                        count = len(self.rooms.get(r, set()))
                    print(f"  {r} ({count} online)")
            elif cmd == "users":
                room = arg.strip()
                if not room:
                    print("Usage: users <room>")
                    continue
                payload = self.user_list_payload(room)
                names = [u["username"] for u in payload["users"]]
                print(f"Users in '{room}': {', '.join(names) if names else '(none)'}")
            elif cmd == "broadcast":
                if not arg:
                    print("Usage: broadcast <message>")
                    continue
                ts = now_ts()
                self.broadcast_to_all({"type": "message", "room": None, "username": "SERVER",
                                        "message": arg, "timestamp": ts, "system": True})
                log(f"Admin broadcast sent: {arg}")
            elif cmd == "kick":
                username = arg.strip()
                if not username:
                    print("Usage: kick <username>")
                    continue
                target_conn = None
                with self.lock:
                    for c, info in self.clients.items():
                        if info["username"] == username:
                            target_conn = c
                            break
                if target_conn:
                    self.send_json(target_conn, {"type": "kicked", "message": "You have been kicked by the admin."})
                    try:
                        target_conn.close()
                    except OSError:
                        pass
                    print(f"Kicked '{username}'.")
                else:
                    print(f"User '{username}' not found online.")
            elif cmd == "shutdown":
                self.running = False
                self.shutdown()
                try:
                    self.server_socket.close()
                except OSError:
                    pass
                os._exit(0)
            else:
                print(f"Unknown command '{cmd}'. Type 'help' for a list of commands.")


# =============================================================================
# SECTION 3: Networking helper for the client
# =============================================================================
class NetworkClient:
    """Owns the raw socket, sends JSON lines, and pushes received JSON
    objects onto a thread-safe queue that the GUI polls periodically."""

    def __init__(self, incoming_queue):
        self.sock = None
        self.incoming = incoming_queue
        self.connected = False
        self._recv_thread = None

    def connect(self, host=SERVER_HOST_FOR_CLIENT, port=DEFAULT_PORT):
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.sock.settimeout(5)
        self.sock.connect((host, port))
        self.sock.settimeout(None)
        self.connected = True
        self._recv_thread = threading.Thread(target=self._recv_loop, daemon=True)
        self._recv_thread.start()

    def send(self, obj):
        if not self.connected or not self.sock:
            return
        try:
            data = (json.dumps(obj) + "\n").encode("utf-8")
            self.sock.sendall(data)
        except OSError:
            self.connected = False

    def _recv_loop(self):
        buffer = ""
        try:
            while self.connected:
                try:
                    chunk = self.sock.recv(4096)
                except OSError:
                    break
                if not chunk:
                    break
                buffer += chunk.decode("utf-8", errors="ignore")
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        obj = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    self.incoming.put(obj)
        finally:
            self.connected = False
            self.incoming.put({"type": "_connection_lost"})

    def close(self):
        self.connected = False
        try:
            if self.sock:
                self.sock.close()
        except OSError:
            pass


# =============================================================================
# SECTION 4: Tkinter GUI Client
# =============================================================================
class ChatClientApp:
    def __init__(self, port=DEFAULT_PORT):
        self.port = port
        self.root = tk.Tk()
        self.incoming = queue.Queue()
        self.net = NetworkClient(self.incoming)

        self.username = None
        self.current_room = None
        self.joined_rooms = set()
        self.rooms_data = []
        self.dark_mode = False
        self.theme = LIGHT_THEME
        self._typing_after_id = None
        self._last_typing_sent = 0
        self._embedded_server = None  # set if we auto-started a local server

        self.root.protocol("WM_DELETE_WINDOW", self.on_close)
        self.show_login()
        self.root.after(100, self.process_queue)

    # ---- networking bootstrap ----
    def ensure_connected(self):
        if self.net.connected:
            return True
        try:
            self.net.connect(port=self.port)
            return True
        except OSError as e:
            if self._embedded_server is None:
                offer = messagebox.askyesno(
                    "Connection Error",
                    f"Could not connect to a server at "
                    f"{SERVER_HOST_FOR_CLIENT}:{self.port}\n\n"
                    "Would you like to auto-start a local server now "
                    "(for testing on this machine)?",
                )
                if offer:
                    return self.start_embedded_server_and_connect()
            else:
                messagebox.showerror("Connection Error", f"Could not connect to server.\n\n{e}")
            return False

    def start_embedded_server_and_connect(self):
        try:
            self._embedded_server = ChatServer(HOST, self.port)
            self._embedded_server.start_in_background()
            import time
            time.sleep(0.4)
            self.net.connect(port=self.port)
            return True
        except OSError as e:
            messagebox.showerror("Connection Error", f"Could not start/connect to local server.\n\n{e}")
            return False

