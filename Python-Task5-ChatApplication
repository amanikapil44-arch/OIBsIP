def main():
    parser = argparse.ArgumentParser(description="Chat Application (single-file server + client)")
    parser.add_argument("mode", nargs="?", default="client", choices=["server", "client"],
                         help="Run as 'server' or 'client' (default: client)")
    parser.add_argument("port", nargs="?", type=int, default=DEFAULT_PORT,
                         help=f"Port number (default: {DEFAULT_PORT})")
    args = parser.parse_args()

    if args.mode == "server":
        server = ChatServer(HOST, args.port)
        try:
            server.start()
        except KeyboardInterrupt:
            server.shutdown()
    else:
        if not TKINTER_AVAILABLE:
            print("ERROR: tkinter is not available in this Python installation.")
            print("Install it (e.g. 'sudo apt install python3-tk' on Debian/Ubuntu,")
            print("or reinstall Python from python.org on Windows/Mac with tcl/tk enabled)")
            print("to run the GUI client. The server does not require tkinter and")
            print("can still be run with: python chat_app.py server")
            sys.exit(1)
        app = ChatClientApp(port=args.port)
        app.run()


if __name__ == "__main__":
    main()
