    # ==========================================================
    # CORE PASSWORD GENERATION LOGIC
    # ==========================================================
    def _get_character_pool(self):
        """
        Build the pool of characters to draw from based on selected options.

        Returns:
            tuple: (combined_pool: str, active_sets: list[str])
                combined_pool is the full string of allowed characters.
                active_sets is a list of the individual character-set
                strings that were selected (used to guarantee variety).

        Raises:
            ValueError: if fewer than 2 character types are selected.
        """
        upper = string.ascii_uppercase
        lower = string.ascii_lowercase
        digits = string.digits
        symbols = "!@#$%^&*()-_=+[]{};:,.<>?/~"

        active_sets = []
        if self.use_upper.get():
            active_sets.append(upper)
        if self.use_lower.get():
            active_sets.append(lower)
        if self.use_digits.get():
            active_sets.append(digits)
        if self.use_symbols.get():
            active_sets.append(symbols)

        if len(active_sets) < 2:
            raise ValueError(
                "Please select at least 2 character types "
                "(uppercase, lowercase, numbers, symbols)."
            )

        if self.exclude_ambiguous.get():
            active_sets = [
                "".join(ch for ch in charset if ch not in AMBIGUOUS_CHARS)
                for charset in active_sets
            ]

        combined_pool = "".join(active_sets)
        return combined_pool, active_sets

    def _generate_secure_password(self, length, pool, active_sets):
        """
        Generate a single cryptographically secure password.

        Uses the `secrets` module exclusively (see security note #1 at
        the top of this file) -- NEVER the `random` module -- so that
        the resulting password is unpredictable and safe for real use.

        Args:
            length (int): Desired password length.
            pool (str): Combined character pool to choose from.
            active_sets (list[str]): Individual selected character sets,
                used only if "ensure one of each type" is enabled.

        Returns:
            str: The generated password.
        """
        password_chars = []

        # Optionally guarantee at least one character from every
        # selected character type so variety isn't left to chance.
        if self.ensure_each_type.get():
            for charset in active_sets:
                if charset:  # guard against an emptied set after exclusions
                    password_chars.append(secrets.choice(charset))

        # Fill the remaining length with secure random choices from
        # the full combined pool.
        while len(password_chars) < length:
            password_chars.append(secrets.choice(pool))

        # If guaranteeing one-of-each pushed us over the requested
        # length (e.g., 4 types requested but length is 8), trim down
        # to the exact requested length AFTER shuffling so we don't
        # systematically drop the guaranteed characters.
        self._secure_shuffle(password_chars)
        password_chars = password_chars[:length]

        return "".join(password_chars)

    @staticmethod
    def _secure_shuffle(items):
        """
        Shuffle a list in place using a Fisher-Yates algorithm powered
        by `secrets.randbelow()` for cryptographic randomness.

        We implement this manually because `random.shuffle()` uses the
        insecure `random` module internally, and the `secrets` module
        does not provide a built-in shuffle function.

        Args:
            items (list): The list to shuffle in place.
        """
        for i in range(len(items) - 1, 0, -1):
            j = secrets.randbelow(i + 1)
            items[i], items[j] = items[j], items[i]

    # ==========================================================
    # STRENGTH CALCULATION
    # ==========================================================
    def _calculate_strength(self, password, num_types_selected):
        """
        Estimate password strength based on length and character variety.

        Args:
            password (str): The generated password.
            num_types_selected (int): How many character-type checkboxes
                are currently selected (1-4).

        Returns:
            tuple: (label: str, score: int 0-100, color: str)
        """
        length = len(password)

        # Base score from length (0-60 points).
        length_score = min(length / 32 * 60, 60)

        # Variety score from number of distinct character types used (0-40 points).
        variety_score = (num_types_selected / 4) * 40

        total = length_score + variety_score

        if total < 35:
            return "Weak", total, self.COLOR_WEAK
        elif total < 60:
            return "Moderate", total, self.COLOR_MODERATE
        elif total < 85:
            return "Strong", total, self.COLOR_STRONG
        else:
            return "Very Strong", total, self.COLOR_VERY_STRONG

    def _draw_strength_bar(self, percent, color=None):
        """
        Render the strength bar on the canvas.

        Args:
            percent (float): Fill percentage (0-100).
            color (str, optional): Fill color. Defaults to a neutral gray.
        """
        self.strength_canvas.delete("all")
        width = self.strength_canvas.winfo_width() or 560
        height = 14
        fill_color = color or "#3a3d54"
        fill_width = int((percent / 100) * width)

        self.strength_canvas.create_rectangle(
            0, 0, width, height, fill=self.COLOR_ENTRY_BG, outline=""
        )
        self.strength_canvas.create_rectangle(
            0, 0, fill_width, height, fill=fill_color, outline=""
        )

    # ==========================================================
    # ACTIONS / EVENT HANDLERS
    # ==========================================================
    def generate_password(self):
        """
        Validate inputs, generate a new secure password, update the
        display, strength bar, history, and status bar.
        """
        try:
            length = int(float(self.length_var.get()))
        except (ValueError, tk.TclError):
            messagebox.showerror("Invalid Length", "Please enter a valid number.")
            return

        # ---- Validation: minimum length ----
        if length < 8:
            messagebox.showerror(
                "Length Too Short",
                "Password length must be at least 8 characters for security.",
            )
            self.length_var.set(8)
            return
        if length > 64:
            length = 64
            self.length_var.set(64)

        # ---- Validation: at least 2 character types ----
        try:
            pool, active_sets = self._get_character_pool()
        except ValueError as err:
            messagebox.showwarning("Selection Required", str(err))
            return

        # ---- Generate ----
        password = self._generate_secure_password(length, pool, active_sets)
        self.current_password = password
        self.password_display_var.set(password)

        # ---- Strength ----
        num_types = sum([
            self.use_upper.get(), self.use_lower.get(),
            self.use_digits.get(), self.use_symbols.get(),
        ])
        label, score, color = self._calculate_strength(password, num_types)
        self.strength_label_var.set(label)
        self.strength_label.config(fg=color)
        self._draw_strength_bar(score, color)

        # ---- History (in-memory only, see security notes) ----
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.password_history.insert(0, (password, timestamp))
        self.password_history = self.password_history[:5]
        self._refresh_history_listbox()

        # ---- Status bar ----
        self.status_var.set(f"Password generated at {timestamp}")

        # ---- Persist non-sensitive settings ----
        self._save_settings()

    def regenerate_password(self):
        """Regenerate a password using the exact same current settings."""
        self.generate_password()

    def copy_to_clipboard(self):
        """
        Copy the currently displayed password to the system clipboard,
        with visual feedback. Optionally schedules an auto-clear.
        """
        if not self.current_password or self.current_password.startswith("Click"):
            messagebox.showinfo("Nothing to Copy", "Generate a password first.")
            return

        if not PYPERCLIP_AVAILABLE:
            messagebox.showerror(
                "pyperclip Not Installed",
                "Please install pyperclip to enable clipboard support:\n\n"
                "    pip install pyperclip",
            )
            return

        try:
            pyperclip.copy(self.current_password)
            self.status_var.set(
                f"Password copied to clipboard at {datetime.now().strftime('%H:%M:%S')}"
            )

            if self.auto_clear_clipboard.get():
                # Schedule clipboard clear after 30 seconds without
                # blocking the GUI event loop.
                self.root.after(30000, self._clear_clipboard_if_unchanged, self.current_password)
        except Exception as err:  # pragma: no cover - defensive
            messagebox.showerror("Clipboard Error", f"Could not copy password:\n{err}")

    def _clear_clipboard_if_unchanged(self, password_that_was_copied):
        """
        Clear the clipboard only if it still contains the password we
        copied (avoids wiping something the user copied afterward).

        Args:
            password_that_was_copied (str): The password to check against.
        """
        try:
            if PYPERCLIP_AVAILABLE and pyperclip.paste() == password_that_was_copied:
                pyperclip.copy("")
                self.status_var.set("Clipboard auto-cleared for security.")
        except Exception:  # pragma: no cover - clipboard access can vary by OS
            pass

    def clear_history(self):
        """Clear the in-memory session password history."""
        if not self.password_history:
            return
        confirm = messagebox.askyesno(
            "Clear History", "Clear all passwords from this session's history?"
        )
        if confirm:
            self.password_history.clear()
            self._refresh_history_listbox()
            self.status_var.set("History cleared.")

    def _refresh_history_listbox(self):
        """Redraw the history listbox from self.password_history."""
        self.history_listbox.delete(0, tk.END)
        for password, timestamp in self.password_history:
            self.history_listbox.insert(tk.END, f"[{timestamp}]  {password}")

    # ==========================================================
    # SETTINGS PERSISTENCE (non-sensitive data only)
    # ==========================================================
    def _save_settings(self):
        """
        Persist non-sensitive user preferences to config.json.

        IMPORTANT: Only settings (length, checkbox states) are saved.
        Passwords themselves and password history are NEVER written
        to disk -- see security note #2 at the top of this file.
        """
        settings = {
            "length": self.length_var.get(),
            "use_upper": self.use_upper.get(),
            "use_lower": self.use_lower.get(),
            "use_digits": self.use_digits.get(),
            "use_symbols": self.use_symbols.get(),
            "exclude_ambiguous": self.exclude_ambiguous.get(),
            "ensure_each_type": self.ensure_each_type.get(),
            "auto_clear_clipboard": self.auto_clear_clipboard.get(),
        }
        try:
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(settings, f, indent=2)
        except OSError as err:  # pragma: no cover - defensive
            # Non-fatal: settings just won't persist this run.
            print(f"Warning: could not save settings ({err})")

    def _load_settings(self):
        """
        Load previously saved (non-sensitive) settings from config.json,
        if it exists. Falls back silently to defaults on any error.
        """
        if not os.path.exists(CONFIG_FILE):
            return
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                settings = json.load(f)

            self.length_var.set(settings.get("length", 16))
            self.use_upper.set(settings.get("use_upper", True))
            self.use_lower.set(settings.get("use_lower", True))
            self.use_digits.set(settings.get("use_digits", True))
            self.use_symbols.set(settings.get("use_symbols", True))
            self.exclude_ambiguous.set(settings.get("exclude_ambiguous", False))
            self.ensure_each_type.set(settings.get("ensure_each_type", True))
            self.auto_clear_clipboard.set(settings.get("auto_clear_clipboard", False))
        except (json.JSONDecodeError, OSError) as err:  # pragma: no cover
            print(f"Warning: could not load settings ({err}). Using defaults.")

    def _on_close(self):
        """Save settings and close the application cleanly."""
        self._save_settings()
        self.root.destroy()


def main():
    """Application entry point."""
    root = tk.Tk()
    app = PasswordGeneratorApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
